# Kick: Creator Dashboard -> Settings -> Stream. Copy the "Stream URL" and "Stream key" here (leave both empty for a 20 s test clip in ./out).
RTMP_URL=rtmps://fa723fc1b171.global-contribute.live-video.net:443/app
STREAM_KEY=
# the scene to broadcast (rotates the game every STREAM_HOURS on the server; see STREAM_GAMES there)
STREAM_URL=https://casino.hackatoa.com/stream
WIDTH=1280
HEIGHT=720
FPS=30
VIDEO_BITRATE=3000k
AUDIO=1
# original lounge music under the game sounds (set MUSIC=0 to turn it off); volumes are relative before the final loudness normaliser
MUSIC=1
MUSIC_VOLUME=0.55
SFX_VOLUME=1.0
